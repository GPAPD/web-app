@model HomeModel

@{
    ViewData["Title"] = "Search Page";
    ViewData["IsBanner"] = true;
}


<div class="text-center">
    <div class="row row-cols-1 row-cols-md-3 g-4 mt-2 mb-2">

        @{
            foreach (var p in Model.ProductList)
            {
                <div class="col">
                    <div class="card h-100">
                        <img src="@p.Image" class="card-img-top img-fluid mx-auto d-block pt-4" alt="@p.ProductName" style="max-width: 200px">
                        <div class="card-body">
                            <h5 class="card-title">@p.ProductName</h5>
                            <p class="card-text">@p.ProductDesc</p>

                            <div class="row">
                                <p class="col-6">Rs.700.00</p>
                                <p class="col-6">Rs.@p.Price</p>
                            </div>

                            <a>Buy Now</a>
                        </div>
                    </div>
                </div>
            }
        }

    </div>
</div>