<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PickitUp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PickitUp.styles.css" asp-append-version="true" />


    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


    <style>
        #suggestions {
            max-height: 200px;
            overflow-y: auto;
        }
    </style>
</head>
<body>
    @*Data variables*@
    @{
        bool? isBannerAvailable = Convert.ToBoolean(ViewBag.IsBanner);
    }

    <header>
        <!--Nav bar-->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PickitUp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Login">Login</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        @if (isBannerAvailable != null && isBannerAvailable == true) 
        {
            //https://www.datamuse.com/api/ -- free word suggestion api
            <!-- Search bar -->
            <div class="row m-2">
                <div class="col-12 d-flex justify-content-end position-relative">
                    <form class="form-inline d-flex" id="my_search" autocomplete="off" method="get" action="@Url.Action("SearchApi", "Home")">
                        <div class="dropdown w-100 position-relative">
                            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search" name="search" id="search-box">
                            <ul id="suggestions" class="dropdown-menu w-100" style="display: none;"></ul>
                        </div>
                        <input class="btn btn-outline-success" value="Search" type="submit" />
                    </form>
                </div>
            </div>

            <!--Banner section-->
            <div>
                <div id="carouselExampleControlsNoTouching" class="carousel slide" data-bs-touch="false">

                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="https://www.tanishq.com/dw/image/v2/BJGM_PRD/on/demandware.static/-/Library-Sites-TanishqSharedLibraryUSA/default/dw4074c54a/Banners/Dailywear_Desktop.jpg" class="d-block w-100" alt="...">
                        </div>
                        <div class="carousel-item">
                            <img src="https://www.tanishq.com/dw/image/v2/BJGM_PRD/on/demandware.static/-/Library-Sites-TanishqSharedLibraryUSA/default/dw67b32eba/homepage/HeroBanner/best%20deals%20may%20web.jpg" class="d-block w-100" alt="...">
                        </div>
                        <div class="carousel-item">
                            <img src="https://www.tanishq.com/dw/image/v2/BJGM_PRD/on/demandware.static/-/Library-Sites-TanishqSharedLibraryUSA/default/dwffb17033/Banners/tanishqgoldcoin_Desktop.jpg" class="d-block w-100" alt="...">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControlsNoTouching" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControlsNoTouching" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        }

    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
            <partial name="_NotificationPartial" />
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - PickitUp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!--word auto suggestion-->

    <script>
        $(function () {
          $('#search-box').on('input', function () {
            const query = $(this).val().trim();
            const $dropdown = $('#suggestions');
            $dropdown.empty();

            if (query.length >= 3) {
              $.ajax({
                url: `https://api.datamuse.com/sug?k=demo&v=enwiki&s=${encodeURIComponent(query)}`,
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                  if (data.length > 0) {
                    data.forEach(item => {
                      $dropdown.append(`<li><a class="dropdown-item" href="#">${item.word}</a></li>`);
                    });
                    $dropdown.show();
                  } else {
                    $dropdown.hide();
                  }
                },
                error: function () {
                  $dropdown.hide();
                }
              });
            } else {
              $dropdown.hide();
            }
          });

          // Fill input on suggestion click
          $(document).on('click', '#suggestions .dropdown-item', function (e) {
            e.preventDefault();
            $('#search-box').val($(this).text());
            $('#suggestions').hide();
          });

          // Hide suggestions when clicking outside
          $(document).on('click', function (e) {
            if (!$(e.target).closest('#search-box').length) {
              $('#suggestions').hide();
            }
          });

          // Optional: handle form submission
          $('#my_search').on('submit', function (e) {
            //e.preventDefault();
            //add the search api
            
            //$.ajax


            //alert('You searched for: ' + $('#search-box').val());
          });
        });
    </script>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
