@model DashbordModel

<div class="container mt-5">
    <h2 class="mb-4">Admin Panel - Product List</h2>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Product Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <!--Product list-->
            @{
                foreach(var p in Model.ProductList) 
                {
                    <tr>
                        <td>@p.Id</td>
                        <td><img src="@p.Image" width="50px" height="50px" alt="Product" class="img-thumbnail"></td>
                        <td>@p.ProductName</td>
                        <td>@p.Price</td>
                        <td>@p.Stock</td>
                        <td>
                            <a href="~/Admin/EditeItemDetails/@p.Id" class="btn btn-sm btn-primary">Edit</a>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>
