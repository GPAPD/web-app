@model DashbordModel

@section Scripts 
{
    <script>
        $(document).ready(function () {
        $('#editBtn').click(function () {
        $('input, textarea,select').prop('disabled', false);
        $('#editBtn').addClass('d-none');
        $('#saveBtn').removeClass('d-none');
        });

        $('#saveBtn').click(function () {
        const IsLive = $('#Live').val();
        console.log(IsLive);

        if ($('#Live').is(':checked')) {
        $("#IsLive").val(true);
        }else
        {
        $("#IsLive").val(false);
        }

        });
        });
    </script>
}

@{
    var cat = new List<string> { "Electronics", "Clothing", "Books", "Home","Office", "Amino", "Acid", "Fat Burner", "Herbal", "Hydration", "Mineral", "Omega", "Performance", "Protein", "Sleep Aid", "Vitamin" };
    var selectedCategory = Model.Product.Category ?? "";
}

<div class="container mt-5">
    <form action="~/Admin/UpdateItem" method="POST">

        <div class="card shadow rounded">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Item Details</h4>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label for="Id" class="form-label">Product Id</label>
                    <input type="text" name="Id" class="form-control" id="Id" value="@Model.Product.Id" disabled>
                </div>

                <div class="mb-3">
                    <label for="ProductName" class="form-label">Product Name</label>
                    <input type="text" name="ProductName" class="form-control" id="ProductName" value="@Model.Product.ProductName" disabled>
                </div>

                <div class="mb-3">
                <label for="Category" class="form-label">Category</label>
                    <select name="Category" class="form-control" id="Category" disabled>
                        <option value="">-- Select Category --</option>
                        @foreach (var c in cat)
                        {
                            if (selectedCategory == c)
                            {
                                <option value="@c" selected="selected">@c</option>
                            }
                            else
                            {
                                <option value="@c">@c</option>
                            }
                        }
                    </select>
                </div>


                <div class="mb-3">
                    <label for="Price" class="form-label">Stock</label>
                    <input type="number" name="Stock" class="form-control" id="Stock" value="@Model.Product.Stock" disabled>
                </div>

                <div class="mb-3">
                    <label for="Price" class="form-label">Price ($)</label>
                    <input type="number" name="Price" class="form-control" id="Price" value="@Model.Product.Price" disabled>
                </div>

                <div class="mb-3">
                    <label for="Image" class="form-label">Image Url</label>
                    <input type="text" name="Image" class="form-control" id="Image" value="@Model.Product.Image" disabled>
                </div>

                <input type="hidden" name="IsLive" id="IsLive" value="" />

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="Live" id="Live"
                    @(Model.Product.IsLive ? "checked" : "") disabled>
                    <label class="form-check-label" for="IsLive">
                        Is Product Live?
                    </label>
                </div>

                <div class="mb-3">
                    <label for="itemDescription" class="form-label">Description</label>
                    <textarea name="ProductDesc" class="form-control" id="ProductDesc" rows="4" disabled>@Model.Product.ProductDesc</textarea>
                </div>

                <div class="d-flex justify-content-end">
                    <button id="editBtn" type="button" class="btn btn-primary me-2">Edit</button>
                    <button id="saveBtn" type="submit" class="btn btn-success d-none">Save</button>
                </div>

            </div>
        </div>
    </form>
</div>



