@model DashbordModel

@section Scripts
{
    <script>
        $(document).ready(function () {

            $('#saveBtn').click(function () 
            {
                const IsLive = $('#Live').val();
                console.log(IsLive);

                if ($('#Live').is(':checked')) 
                {
                    $("#IsLive").val(true);
                }else
                {
                    $("#IsLive").val(false);
                }

            });
        });
    </script>
}


<div class="container mt-5">
    <form action="~/Admin/SaveNewItem" method="POST">

        <div class="card shadow rounded">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Item Details</h4>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label for="ProductName" class="form-label">Product Name</label>
                    <input type="text" name="ProductName" class="form-control" id="ProductName" value="" required>
                </div>

                @* @{ *@
                @*     var cat = new List<string> { "Electronics", "Clothing", "Books", "Home", "Office", "Amino", "Acid", "Fat Burner", "Herbal", "Hydration", "Mineral", "Omega", "Performance", "Protein", "Sleep Aid", "Vitamin" }; *@
                @* } *@

                <div class="mb-3">
                    <label for="Category" class="form-label">Category</label>
                    <select id="Category" name="Category" class="form-control">
                        @if (Model?.ItemCatogories != null && Model.ItemCatogories.Any())
                        {
                            foreach (var item in Model.ItemCatogories)
                            {
                                <option value="@item">@item</option>
                            }
                        }
                        else
                        {
                            <option value="">No categories available</option>
                        }
                    </select>
                </div>


                <div class="mb-3">
                    <label for="Price" class="form-label">Stock</label>
                    <input type="number" name="Stock" class="form-control" id="Stock" value="" required>
                </div>

                <div class="mb-3">
                    <label for="Price" class="form-label">Price ($)</label>
                    <input type="number" name="Price" class="form-control" id="Price" value="" required>
                </div>

                <div class="mb-3">
                    <label for="Image" class="form-label">Image Url</label>
                    <input type="text" name="Image" class="form-control" id="Image" value="" required>
                </div>

                <input type="hidden" name="IsLive" id="IsLive" value="" />

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="Live" id="Live">
                    <label class="form-check-label" for="IsLive">
                        Is Product Live?
                    </label>
                </div>

                <div class="mb-3">
                    <label for="itemDescription" class="form-label">Description</label>
                    <textarea name="ProductDesc" class="form-control" id="ProductDesc" rows="4" required></textarea>
                </div>

                <div class="d-flex justify-content-end">
                    <button id="saveBtn" type="submit" class="btn btn-success">Save</button>
                </div>

            </div>
        </div>
    </form>
</div>



